#include "LPC17xx.h"

void EINT3_IRQHandler(void)
{
    if (LPC_GPIOINT->IO2IntStatR & (1 << 0))
    {
        LPC_GPIO1->FIOPIN ^= (1 << 18);
        LPC_GPIOINT->IO2IntClr = (1 << 0);
    }
}

void GPIO_Interrupt_Init(void)
{
    // Enable internal pull-down resistor on P2.0 — no external resistor needed!
    LPC_PINCON->PINMODE4 |= (3 << 0);

    // Set P2.0 (mbed p26) as INPUT for button
    LPC_GPIO2->FIODIR &= ~(1 << 0);

    // Set P1.18 (mbed LED1) as OUTPUT for LED
    LPC_GPIO1->FIODIR |= (1 << 18);

    // Enable Rising Edge interrupt on P2.0
    LPC_GPIOINT->IO2IntEnR |= (1 << 0);

    // Clear any pending interrupt before enabling
    LPC_GPIOINT->IO2IntClr = (1 << 0);

    // Enable EINT3 in NVIC
    NVIC_EnableIRQ(EINT3_IRQn);
}

int main(void)
{
    GPIO_Interrupt_Init();
    while(1)
    {
        // CPU free — interrupt handles button automatically
    }
}
